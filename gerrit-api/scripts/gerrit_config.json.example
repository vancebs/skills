{
  "GERRIT_URL": "https://gerrit.example.com",
  "GERRIT_USERNAME": "john.doe",
  "GERRIT_HTTP_PASSWORD": "your-http-credential-token",

  "_comment_ssl": "Set to 'true' to disable SSL certificate verification (fixes CERTIFICATE_VERIFY_FAILED). Default: 'false'.",
  "GERRIT_DISABLE_SSL_VERIFY": "false",

  "_comment_ssh": "SSH settings for stream-events. ssh_host defaults to the host in GERRIT_URL.",
  "GERRIT_SSH_PORT": "29418",
  "GERRIT_SSH_KEY": "~/.ssh/id_rsa"
}
